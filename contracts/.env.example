# Copy to .env and fill in — NEVER commit the real .env
# Base Sepolia RPC endpoint (public: https://sepolia.base.org, or use Alchemy/Infura)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployer wallet private key (testnet-only wallet! never reuse a mainnet key)
DEPLOYER_PRIVATE_KEY=

# BaseScan API key for contract verification (https://basescan.org/myapikey)
BASESCAN_API_KEY=
